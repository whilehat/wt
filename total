<!DOCTYPE html>
<html>
<head>
    <title>Feedback App</title>
</head>

<body>

<h2>Feedback App</h2>

<textarea id="review" placeholder="Write your review"></textarea>
<br><br>

<select id="rating">
    <option>5</option>
    <option>4</option>
    <option>3</option>
    <option>2</option>
    <option>1</option>
</select>

<button onclick="addReview()">Submit</button>

<h2>Reviews</h2>
<div id="list"></div>

<script>
function addReview() {

    let r = document.getElementById("review").value;
    let s = document.getElementById("rating").value;

    if (r == "") {
        alert("Please enter a review");
        return;
    }

    let card = document.createElement("div");

    card.innerHTML = r + " ⭐ " + s;

    card.style.border = "1px solid black";
    card.style.padding = "50px";
    card.style.margin = "50px";

    document.getElementById("list").appendChild(card);

   
}
</script>

</body>
</html>
 
