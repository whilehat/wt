<!DOCTYPE html>
<html>
<head>
    <title>Form Validation</title>
</head>

<body>

<h2>Registration Form</h2>

<form onsubmit="return validate()">

    Full Name:
    <input type="text" id="name"><br>
    <p id="e1" style="color:red"></p>

    Email:
    <input type="text" id="email"><br>
    <p id="e2" style="color:red"></p>

    Password:
    <input type="password" id="pass"><br>
    <p id="e3" style="color:red"></p>

    <button type="submit">Submit</button>

</form>

<script>
function validate() {

    let n = document.getElementById("name").value;
    let e = document.getElementById("email").value;
    let p = document.getElementById("pass").value;

    e1.innerHTML = n == "" ? "Name is required" : "";
    e2.innerHTML = e == "" ? "Email is required" : "";
    e3.innerHTML = p.length <= 6 ?
                  "Password must exceed 6 characters" : "";

    return n != "" && e != "" && p.length > 6;
}
</script>

</body>
</html>


